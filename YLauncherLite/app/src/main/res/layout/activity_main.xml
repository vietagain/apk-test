<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F141A"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/banner_web_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3A8A"
        android:padding="10dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_web_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="http://192.168.1.xxx:8080"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/header_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#17202A"
        android:orientation="horizontal"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_date_solar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chủ Nhật, 22/11/2026"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_date_lunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Âm lịch: 14/10"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_status_ha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Đang kết nối..."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_weather_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☀️ Thời tiết"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_outdoor_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngoài trời: --°C"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_sensor_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌡 --°C"
                    android:textColor="#F87171"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tv_sensor_hum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💧 --%"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tv_sensor_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ --W"
                    android:textColor="#FACC15"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <GridLayout
            android:id="@+id/grid_tiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btn_web_config"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#CC1E293B"
            android:text="⚙ Cấu hình Web"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_key_map"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#CC1E293B"
            android:text="🔘 Phím Nguồn Ảo"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_apps"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#CC1E293B"
            android:text="📱 Ứng dụng"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
